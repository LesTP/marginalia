{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference-corpus.local/schemas/source.schema.json",
  "title": "Scholarly source record",
  "description": "Bibliographic, provenance, access, quality, and rights metadata for one source.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "provenance",
    "bibliography",
    "source_type",
    "quality",
    "access",
    "rights"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "vocabularies.schema.json#/$defs/schemaVersion"},
    "record_type": {"const": "source"},
    "id": {"type": "string", "pattern": "^src_[0-9a-f]{16}$"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "bibliography": {"$ref": "#/$defs/bibliography"},
    "source_type": {"$ref": "vocabularies.schema.json#/$defs/sourceType"},
    "source_type_detail": {"type": "string", "minLength": 1},
    "quality": {"$ref": "#/$defs/quality"},
    "access": {"$ref": "#/$defs/access"},
    "rights": {"$ref": "#/$defs/rights"},
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"source_type": {"const": "other"}}, "required": ["source_type"]},
      "then": {"required": ["source_type_detail"]}
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "enum": ["doi", "isbn", "archive-id", "uri", "bibliographic-key", "other"]
        },
        "value": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"scheme": {"const": "other"}}, "required": ["scheme"]},
          "then": {"required": ["detail"]}
        }
      ]
    },
    "contributor": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": ["author", "editor", "translator", "compiler", "other"]
        },
        "role_detail": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "other"}}, "required": ["role"]},
          "then": {"required": ["role_detail"]}
        }
      ]
    },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "bibliography": {
      "type": "object",
      "required": ["title", "contributors", "citation"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contributor"}
        },
        "issued": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "container_title": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "minLength": 1},
        "volume": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1},
        "pages": {"type": "string", "minLength": 1},
        "identifiers": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        },
        "canonical_url": {"type": "string", "format": "uri"},
        "citation": {"type": "string", "minLength": 1}
      }
    },
    "quality": {
      "type": "object",
      "required": ["authority", "peer_review_status", "rationale"],
      "additionalProperties": false,
      "properties": {
        "authority": {"$ref": "vocabularies.schema.json#/$defs/authorityCategory"},
        "peer_review_status": {"$ref": "vocabularies.schema.json#/$defs/peerReviewStatus"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "access": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "vocabularies.schema.json#/$defs/accessState"},
        "consulted_on": {"type": "string", "format": "date"},
        "scope_note": {"type": "string", "minLength": 1},
        "obtained_via": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "fully-consulted"}}, "required": ["state"]},
          "then": {"required": ["consulted_on"]}
        },
        {
          "if": {"properties": {"state": {"const": "excerpt-consulted"}}, "required": ["state"]},
          "then": {"required": ["consulted_on", "scope_note"]}
        },
        {
          "if": {"properties": {"state": {"enum": ["citation-only", "unavailable"]}}, "required": ["state"]},
          "then": {"required": ["scope_note"]}
        }
      ]
    },
    "rights": {
      "type": "object",
      "required": ["status", "quotation", "reproduction", "notes"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "vocabularies.schema.json#/$defs/rightsStatus"},
        "quotation": {"$ref": "vocabularies.schema.json#/$defs/rightsPermission"},
        "reproduction": {"$ref": "vocabularies.schema.json#/$defs/rightsPermission"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
